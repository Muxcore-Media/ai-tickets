[Unit]
Description=MuxCore Module - ai-tickets
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/ai-tickets \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id ai-tickets
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-tickets

[Install]
WantedBy=multi-user.target
